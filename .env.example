# Copy to .env and replace secrets with your local development credentials.
# Never put real credentials in this file; .env is excluded by .gitignore.

# Local PostgreSQL / Redis / object storage
DATABASE_URL=postgresql+psycopg://agent:local-dev-only@127.0.0.1:5432/agent
CHECKPOINT_DATABASE_URL=postgresql://agent:local-dev-only@127.0.0.1:5432/agent
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=agent-payloads
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Local identity bindings: configure a tenant/user/scopes for development.
AUTH_BINDINGS_JSON=[]

# Chat model. Ollama is local; use LLM_PROVIDER=gemini and provide Gemini settings
# when using Gemini. Gemini credentials may also be needed for embeddings.
LLM_PROVIDER=ollama
OLLAMA_MODEL_NAME=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_MODEL_NAME=
GEMINI_API_KEY=
# Legacy aliases accepted by settings; prefer the provider-specific names above.
MODEL_NAME=
MODEL_API_KEY=

# PayPal sandbox credentials and tenant binding (optional).
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Older names are accepted aliases; leave empty when using the sandbox names.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_TENANT_ID=
PAYPAL_SANDBOX_WRITES_ENABLED=false

# Embeddings and knowledge ingestion
EMBEDDING_MODEL=
EMBEDDING_VERSION=
EMBEDDING_DIMENSION=
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_CHUNK_CHARS=1800
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_MAX_CHUNKS=256

# Agent, retrieval, and execution limits
GRAPH_VERSION=v2
PROMPT_VERSION=v2
POLICY_VERSION=v1
LLM_TRACE_DIR=runtime/llm-traces
ENDPOINT_CATALOG_PATH=runtime/tool-drafts/endpoint-catalog.json
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_RETRY_INITIAL_SECONDS=10
LLM_RETRY_MAX_SECONDS=30
LLM_THINKING_LEVEL=medium
CANDIDATE_TOOLS_PER_SUBGOAL=5
RETRIEVAL_BRANCH_LIMIT=20
TAXONOMY_DISTANCE_THRESHOLD=0.42
KNOWLEDGE_PASSAGES=4
TRAJECTORY_LIMIT=2
MAX_PLAN_STEPS=10
MAX_REPLANS=2
MAX_TOOL_ATTEMPTS=3
WORKER_POLL_SECONDS=1
WORKER_HEARTBEAT_SECONDS=5
TOOL_TIMEOUT_SECONDS=30
GRAPH_RECURSION_LIMIT=200
PAYLOAD_OFFLOAD_BYTES=65536
RETENTION_DAYS=

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_CAPTURE_CONTENT=true
LANGFUSE_ENVIRONMENT=development
LANGFUSE_TIMEOUT_SECONDS=5
LANGFUSE_MAX_CONTENT_CHARS=32000

# Optional legacy UI and integration-test settings
AGENT_API_URL=http://127.0.0.1:8000
# TEST_DATABASE_URL=postgresql+psycopg://agent:local-dev-only@127.0.0.1:5432/agent_test
TEST_EMBEDDING_DIMENSION=3
